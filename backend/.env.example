# .env.example
# -------------------------------------------------
# AWS credentials (use IAM roles or Parameter Store in production)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# Database connection (AWS RDS PostgreSQL)
# Format: postgres://username:password@host:5432/database_name
DATABASE_URL=postgres://username:password@your-rds-endpoint:5432/yourdbname

# Application settings
PORT=3000
JWT_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:3000

# Optional: S3 bucket for file storage
AWS_S3_BUCKET_NAME=your-bucket-name

# SES email sender address
SES_FROM_EMAIL=no-reply@yourdomain.com
