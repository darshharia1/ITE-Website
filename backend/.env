SECRET_KEY=ite-startup-launchpad-super-secret-key-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Database Configuration ─────────────────────────────────────────────────────
# For LOCAL development with Docker Compose, use:
#   DATABASE_URL=postgresql://ite_user:ite_password@localhost:5432/ite_db
#
# For LOCAL development without Docker (SQLite fallback), use:
#   DATABASE_URL=sqlite:///./ite.db
#
# For PRODUCTION on Render, this is auto-set via render.yaml — do NOT hardcode.
#   The Render dashboard will inject the DATABASE_URL from the provisioned
#   PostgreSQL instance automatically.
#
# Default: Use local Docker Compose Postgres
DATABASE_URL=sqlite:///./ite.db
